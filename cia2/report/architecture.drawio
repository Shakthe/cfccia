<mxfile host="drawio"><diagram name="VitalWatch-Fog"><mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1180" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="VitalWatch-Fog: latency-aware task scheduling and load balancing" style="text;html=1;fontSize=22;fontStyle=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;align=center;strokeColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="10" width="900" height="36" as="geometry"/></mxCell>
<mxCell id="L1" value="LAYER 1 - IoT / wearables (patients in 3 wards)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=15;fontStyle=1;fontFamily=Architects Daughter;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1120" height="120" as="geometry"/></mxCell>
<mxCell id="w1" value="Ward A wearables&lt;br&gt;HR, SpO2, BP, temp, ECG patch&lt;br&gt;(25% of patients)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90" y="95" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="w2" value="ICU wearables&lt;br&gt;HR, SpO2, BP, temp, ECG patch&lt;br&gt;(25% of patients)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="465" y="95" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="w3" value="General ward / OPD wearables&lt;br&gt;HR, SpO2, BP, temp, ECG patch&lt;br&gt;(50% of patients)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="95" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="L2" value="LAYER 2 - Fog layer" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=15;fontStyle=1;fontFamily=Architects Daughter;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="1120" height="400" as="geometry"/></mxCell>
<mxCell id="sch" value="&lt;b&gt;LAPS scheduler (runs on every ward gateway)&lt;/b&gt;&lt;br&gt;1. estimate response = wait + transfer + run + return&lt;br&gt;2. drop nodes that miss the deadline / break core reservation&lt;br&gt;3. cost = wL x latency + wE x energy + wU x CPU load&lt;br&gt;4. pick lowest cost -> local fog, peer fog, or cloud" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;align=left;spacingLeft=8;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="265" width="580" height="105" as="geometry"/></mxCell>
<mxCell id="par" value="&lt;b&gt;Inputs per task&lt;/b&gt;&lt;br&gt;priority (P1/P2/P3)&lt;br&gt;deadline&lt;br&gt;latency estimate&lt;br&gt;CPU utilisation&lt;br&gt;link bandwidth&lt;br&gt;energy (J)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=12;align=left;spacingLeft=6;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="150" height="125" as="geometry"/></mxCell>
<mxCell id="lb" value="&lt;b&gt;Load balancer&lt;/b&gt;&lt;br&gt;fog-to-fog spill when local node is busy;&lt;br&gt;core reservation: ECG &lt;= 75%, bulk &lt;= 50% of cores" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=12;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="930" y="262" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;fog-1&lt;/b&gt; Ward A gateway&lt;br&gt;Raspberry Pi 4 class&lt;br&gt;4 cores x 1000 MIPS" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;verticalAlign=top;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="290" height="190" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;fog-2&lt;/b&gt; ICU gateway&lt;br&gt;Jetson Nano class&lt;br&gt;4 cores x 1400 MIPS" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;verticalAlign=top;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="445" y="420" width="290" height="190" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;fog-3&lt;/b&gt; hospital fog server&lt;br&gt;Intel NUC class&lt;br&gt;4 cores x 3000 MIPS" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=13;verticalAlign=top;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="290" height="190" as="geometry"/></mxCell>
<mxCell id="q1" value="task queue: P1 critical | P2 ECG | P3 bulk&lt;br&gt;(priority, then earliest deadline)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSize=11;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="490" width="260" height="50" as="geometry"/></mxCell>
